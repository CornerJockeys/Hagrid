{
  "name": "hagrid",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-first Rocket League franchise operations and analytics bot.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc -p activity/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:activity": "vite build activity",
    "dev": "npm run build:activity && wrangler dev",
    "dev:activity": "vite activity",
    "deploy": "npm run build:activity && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hagrid --local",
    "db:migrate:remote": "wrangler d1 migrations apply hagrid --remote",
    "register:commands": "node scripts/register-commands.mjs",
    "smoke:live-sources": "node --experimental-strip-types scripts/live-source-smoke.mjs",
    "smoke:deployed": "node scripts/deployed-smoke.mjs",
    "prepare:deploy-config": "node scripts/prepare-deploy-config.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
